# Server Dashboard — environment configuration (TEMPLATE)
# Copy to .env (local dev) or /etc/dashboard/dashboard.env (systemd) and edit.
# Never commit the real file: it contains secrets.
#
# The server automatically loads ./.env at startup (override with DASH_ENV_FILE).
# Real environment variables always take precedence over the file.

# ---- HTTP -------------------------------------------------------------------
# Address the Go server listens on. Keep it on loopback when nginx proxies it.
DASH_ADDR=127.0.0.1:8080

# Directory containing the built frontend (frontend/dist). Empty disables SPA serving.
DASH_STATIC_DIR=./frontend/dist

# Comma-separated list of allowed browser origins for REST + WebSocket calls.
DASH_ALLOWED_ORIGINS=https://dash.example.com

# Set to true when nginx terminates TLS in front of the app.
DASH_COOKIE_SECURE=true
# Trust X-Forwarded-For / X-Forwarded-Proto from the reverse proxy.
DASH_TRUSTED_PROXY=true

# ---- Secrets (REQUIRED) -----------------------------------------------------
# At least 32 characters. Generate with: openssl rand -hex 32
DASH_SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Initial admin account, created only when the users table is empty.
# Leave the password empty to have one generated and printed once at first start.
DASH_BOOTSTRAP_USER=admin
DASH_BOOTSTRAP_PASSWORD=

# ---- Storage ----------------------------------------------------------------
DASH_DB_PATH=./data/dashboard.db
# Top-most directory the file manager may touch. Set to "/" for unrestricted
# access to the whole filesystem; use an absolute path (e.g.
# /srv/dashboard/workspace) to keep a real sandbox.
DASH_WORKSPACE_ROOT=/
# Working directory (and HOME) for new PTY shells.
DASH_HOME_DIR=/root

# ---- Sessions ---------------------------------------------------------------
DASH_SESSION_TTL=12h

# ---- Terminal ---------------------------------------------------------------
DASH_SHELL=/bin/bash
DASH_TERMINAL_MAX_SESSIONS=8
DASH_TERMINAL_MAX_PER_USER=8
DASH_TERMINAL_IDLE_TIMEOUT=30m
DASH_TERMINAL_SCROLLBACK_BYTES=65536
DASH_TERMINAL_HISTORY=true

# ---- SSH connection manager -------------------------------------------------
# Reads and writes ~/.ssh/config (the standard OpenSSH client format, the same
# one VSCode Remote-SSH uses) and opens sessions with the real ssh binary.
DASH_SSH_ENABLED=true
# Writable config file. Empty means $DASH_HOME_DIR/.ssh/config.
# Files reached through an `Include` directive are always read-only.
DASH_SSH_CONFIG=
DASH_SSH_BIN=ssh
DASH_SSH_KEYSCAN_BIN=ssh-keyscan
DASH_SSH_KEYGEN_BIN=ssh-keygen
# Remote half of the terminal status strip (CPU/memori/bandwidth/disk host SSH).
# Set false to stop the read-only probe over ssh entirely.
DASH_SSH_STATS=true

# ---- Host monitoring --------------------------------------------------------
# How often host metrics (CPU, memory, disks, network, processes) are sampled.
DASH_MONITOR_INTERVAL=1s

# ---- Host operations (layanan, proses, log, pembaruan paket) ----------------
# Turns the "Sistem" pages on or off. Each page also checks the host itself and
# explains what is missing, so this is only needed to hide the feature entirely.
DASH_OPS_ENABLED=true
# Executables used for service control and journal reads.
DASH_OPS_SYSTEMCTL_BIN=systemctl
DASH_OPS_JOURNALCTL_BIN=journalctl
# The log reader may only read inside this directory (symlinks are resolved and
# re-checked, so nothing outside can be reached).
DASH_OPS_LOG_DIR=/var/log
# procfs mount point for the process list.
DASH_OPS_PROC_ROOT=/proc

# ---- Two-factor authentication (TOTP) ---------------------------------------
# Label shown next to the account name in Google Authenticator & friends.
# The secret itself is generated per user in the UI (Keamanan page).
DASH_TOTP_ISSUER=Server Dashboard

# ---- File limits ------------------------------------------------------------
DASH_MAX_READ_SIZE=64M
DASH_MAX_WRITE_SIZE=64M
DASH_MAX_LIST_ENTRIES=50000
# Largest single file accepted by the upload endpoint. Keep the nginx directive
# client_max_body_size in step (deploy/nginx/) or the proxy rejects it first.
DASH_MAX_UPLOAD_SIZE=512M

# ---- Audit ------------------------------------------------------------------
# Audit rows older than this are pruned periodically. 0 disables pruning.
DASH_AUDIT_RETENTION_DAYS=30

# ---- Logging ----------------------------------------------------------------
# debug | info | warn | error
DASH_LOG_LEVEL=info
